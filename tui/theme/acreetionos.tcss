/* AcreetionOS Dark Theme for AIDEN TUI */
/* Based on the AcreetionOS brand colors */

Screen {
    background: #121212;
}

Header {
    background: #1a1a1a;
    color: #e5e5e5;
}

Footer {
    background: #1a1a1a;
    color: #b2b2b2;
}

Static {
    background: transparent;
    color: #e5e5e5;
}

Input {
    background: #222222;
    border: solid #333333;
    color: #e5e5e5;
}

Button {
    background: #222222;
    color: #e5e5e5;
    border: solid #333333;
}

Button.primary {
    background: #2ecc71;
    color: #000;
    border: none;
}

Button.error {
    background: #e74c3c;
    color: #fff;
    border: none;
}

ListView {
    background: #222222;
    border: solid #333333;
}

ListItem {
    background: #222222;
    color: #e5e5e5;
}

ListItem:hover {
    background: #1a1a1a;
}

TabbedContent {
    background: #222222;
    border: solid #333333;
}

DataTable {
    background: #222222;
    border: solid #333333;
    color: #e5e5e5;
}

RichLog {
    background: transparent;
    color: #e5e5e5;
}

Select {
    background: #222222;
    border: solid #333333;
    color: #e5e5e5;
}

#chat-container {
    height: 100%;
}

#chat-log {
    height: 1fr;
    border: none;
}

#chat-input {
    dock: bottom;
}

#toolbar {
    height: 3;
    dock: top;
}

#disclaimer-container {
    align: center middle;
    width: 80%;
    height: auto;
    margin: 2 4;
}

#disclaimer-text {
    text-style: bold;
    margin-bottom: 1;
}

#disclaimer-buttons {
    align-horizontal: center;
    margin-top: 1;
}

#settings-container {
    height: 100%;
}

#history-container {
    height: 100%;
}

#search-input {
    dock: top;
    margin: 0 0 1 0;
}

#conversation-list {
    height: 2fr;
}

#preview-area {
    height: 1fr;
    border: solid #333333;
    margin-top: 1;
    padding: 1;
}

#process-container {
    height: 100%;
}

#resources-display {
    margin-bottom: 1;
}

#services-table {
    height: 2fr;
}

#key-setup-container {
    align: center middle;
    width: 80%;
    height: auto;
    margin: 2 4;
}

#mesh-container {
    height: 100%;
}

#peers-table {
    height: 1fr;
}

#credits-container {
    align: center middle;
    width: 80%;
    height: auto;
    margin: 2 4;
}

#credits-text {
    text-style: bold;
    margin-bottom: 1;
}

#dev-title {
    text-style: bold;
    margin-bottom: 1;
}

#mesh-title {
    text-style: bold;
    margin-bottom: 1;
}

#key-setup-title {
    text-style: bold;
    margin-bottom: 1;
}

#key-setup-desc {
    margin-bottom: 1;
}

#key-status {
    margin-bottom: 1;
}

#modal-container {
    align: center middle;
    width: 60%;
    height: auto;
    background: #1a1a1a;
    border: solid #333333;
}

#modal-title {
    text-style: bold;
    margin-bottom: 1;
}

#pwd-input {
    margin-bottom: 1;
}

#mesh-controls {
    height: 3;
    margin-bottom: 1;
}
