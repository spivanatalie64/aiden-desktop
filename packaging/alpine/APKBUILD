# Maintainer: natalie <natalie@acreetionos.org>
pkgname=aiden-desktop
pkgver=1.0.0
pkgrel=0
pkgdesc="AI desktop assistant with code execution, encrypted storage, and LAN mesh"
url="https://gitlab.acreetionos.org/natalie/aiden-desktop"
arch="x86_64"
license="GPL-3.0-or-later"
depends="python3 py3-requests gtk3 webkit2gtk-4.1 librsvg"
makedepends="cargo npm nodejs python3-dev gtk3-dev webkit2gtk-4.1-dev
             librsvg-dev openssl-dev curl-dev"
source="$url/-/archive/v$pkgver/aiden-desktop-v$pkgver.tar.gz"
options="!check"

build() {
  cd desktop/web
  npm ci
  npm run build
  cd ../..
  cargo tauri build --bundles deb --project-dir desktop/src-tauri
}

package() {
  install -Dm755 desktop/src-tauri/target/release/aiden-desktop "$pkgdir"/usr/bin/aiden-desktop
  install -Dm644 packaging/org.acreetionos.Aiden.desktop "$pkgdir"/usr/share/applications/org.acreetionos.Aiden.desktop
  install -Dm644 desktop/src-tauri/icons/32x32.png "$pkgdir"/usr/share/icons/hicolor/32x32/apps/aiden-desktop.png
  install -Dm644 desktop/src-tauri/icons/128x128.png "$pkgdir"/usr/share/icons/hicolor/128x128/apps/aiden-desktop.png
  install -Dm644 desktop/src-tauri/icons/128x128@2x.png "$pkgdir"/usr/share/icons/hicolor/256x256/apps/aiden-desktop.png
  install -Dm644 packaging/org.acreetionos.Aiden.metainfo.xml "$pkgdir"/usr/share/metainfo/org.acreetionos.Aiden.metainfo.xml
}

sha512sums="SKIP"
